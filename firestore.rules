rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Teacher profiles
    match /teachers/{teacherId} {
      allow get: if isSignedIn() && request.auth.uid == teacherId;
      allow create, update: if isSignedIn() && request.auth.uid == teacherId
        && isValidId(teacherId)
        && incoming().uid == request.auth.uid;
      allow delete: if false;
    }

    // Teacher reading resources
    match /resources/{resourceId} {
      allow get: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      
      allow create: if isSignedIn()
        && isValidId(resourceId)
        && incoming().ownerId == request.auth.uid
        && incoming().title is string && incoming().title.size() <= 200
        && incoming().category is string && incoming().category.size() <= 100
        && incoming().canonicalText is string && incoming().canonicalText.size() <= 100000;

      allow update: if isSignedIn()
        && isValidId(resourceId)
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().title is string && incoming().title.size() <= 200
        && incoming().category is string && incoming().category.size() <= 100
        && incoming().canonicalText is string && incoming().canonicalText.size() <= 100000;

      allow delete: if isSignedIn()
        && isValidId(resourceId)
        && existing().ownerId == request.auth.uid;
    }

    // Classroom live rooms
    match /rooms/{roomId} {
      // Learners with link need to read room state for current unit & sync
      allow get: if isValidId(roomId);
      allow list: if isSignedIn() && resource.data.teacherId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(roomId)
        && incoming().teacherId == request.auth.uid
        && incoming().status in ['active', 'ended'];

      allow update: if isSignedIn()
        && isValidId(roomId)
        && existing().teacherId == request.auth.uid
        && incoming().teacherId == existing().teacherId;

      allow delete: if isSignedIn()
        && isValidId(roomId)
        && existing().teacherId == request.auth.uid;

      // Room participants subcollection
      match /participants/{participantId} {
        allow get: if isValidId(roomId) && isValidId(participantId);
        allow list: if isValidId(roomId);

        allow create: if isValidId(roomId)
          && isValidId(participantId)
          && incoming().participantId == participantId
          && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 80;

        allow update: if isValidId(roomId) && isValidId(participantId);
        allow delete: if isValidId(roomId) && isValidId(participantId);
      }
    }
  }
}
